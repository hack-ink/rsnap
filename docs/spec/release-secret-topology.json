{
  "schemaVersion": 2,
  "project": {
    "name": "rsnap-release",
    "provider": "infisical",
    "domain": "http://127.0.0.1:51890",
    "projectId": "f55a1068-0ae7-4dee-a0c0-62bfe71016fc"
  },
  "defaults": {
    "imports": false,
    "recursive": false,
    "expansion": false,
    "overriding": false,
    "broadParentGrant": false
  },
  "profiles": [
    {
      "id": "apple-release",
      "class": "macOS distribution signing and notarization",
      "path": "/release/apple",
      "environments": [
        "prod"
      ],
      "owner": "acgxv",
      "consumers": [
        "acg-box GitHub-hosted release workflows through organization Actions secrets"
      ],
      "requiredKeys": [
        "APPLE_DEVELOPER_ID_APPLICATION_P12_BASE64",
        "APPLE_DEVELOPER_ID_APPLICATION_P12_PASSWORD",
        "APPLE_DEVELOPER_ID_APPLICATION_IDENTITY",
        "APPLE_NOTARY_KEY_ID",
        "APPLE_NOTARY_ISSUER_ID",
        "APPLE_NOTARY_KEY_P8"
      ]
    },
    {
      "id": "rsnap-sparkle",
      "class": "Rsnap Sparkle Ed25519 update signing",
      "path": "/release/sparkle",
      "environments": [
        "prod"
      ],
      "owner": "acgxv",
      "consumers": [
        "acg-box/rsnap Release workflow through organization Actions secret RSNAP_SPARKLE_PRIVATE_ED_KEY"
      ],
      "requiredKeys": [
        "RSNAP_SPARKLE_PRIVATE_ED_KEY"
      ]
    }
  ],
  "identities": [
    {
      "id": "rsnap-release-provisioner",
      "purpose": "Provision, verify, rotate, and retire Rsnap release material",
      "owner": "acgxv",
      "trustBoundary": "Single-operator local macOS host and loopback personal Infisical instance",
      "auth": {
        "method": "universal-auth",
        "selector": "identity:ac5f2cd1-4cfa-49a5-a9f4-9534a6111138"
      },
      "delivery": "Per-invocation upstream Infisical CLI token with explicit target arguments",
      "credentialLifecycle": {
        "rotation": "Create and validate a replacement Universal Auth client secret before revoking the previous credential",
        "revocation": "Revoke the exact Universal Auth client secret and preserve the protected infisical-selfhost Keychain trust root"
      }
    }
  ],
  "accessBindings": [
    {
      "identity": "rsnap-release-provisioner",
      "profile": "apple-release",
      "environments": [
        "prod"
      ],
      "actions": [
        "read",
        "create",
        "edit",
        "delete"
      ]
    },
    {
      "identity": "rsnap-release-provisioner",
      "profile": "rsnap-sparkle",
      "environments": [
        "prod"
      ],
      "actions": [
        "read",
        "create",
        "edit",
        "delete"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "dedicated-project-member-grant",
      "rule": "defaults.broadParentGrant",
      "owner": "acgxv",
      "approver": "acgxv",
      "reason": "The provisioner has project-member access because the dedicated project contains only the two declared Rsnap release profiles",
      "expiresAt": "2027-01-26T00:00:00Z"
    }
  ]
}
