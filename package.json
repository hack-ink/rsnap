{
  "name": "rsnap-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "format": "oxfmt scripts/release/*.ts scripts/release/tests/*.ts",
    "format:check": "oxfmt --check scripts/release/*.ts scripts/release/tests/*.ts",
    "lint": "oxlint --type-aware --type-check --deny-warnings scripts/release/*.ts scripts/release/tests/*.ts",
    "test": "node --test scripts/release/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "26.5.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.5.1",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
